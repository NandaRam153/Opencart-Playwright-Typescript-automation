{
  "name": "opencart-playwright-typescript-automation",
  "version": "1.0.0",
  "description": "Uses Playwright &amp; Typescript to automate e2e work flow of Opencart website",
  "main": "index.js",
  "scripts": {    
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "test:docker": "docker build -t playwright-tests . && docker run --rm playwright-tests",
    "test:docker:debug": "docker run -it --rm --entrypoint sh playwright-tests",
    "test:docker:compose": "docker-compose up --build",
    "report:docker": "docker run --rm -v $(pwd)/playwright-report:/app/playwright-report playwright-tests npx playwright show-report"
    },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NandaRam153/Opencart-Playwright-Typescript-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/NandaRam153/Opencart-Playwright-Typescript-automation/issues"
  },
  "homepage": "https://github.com/NandaRam153/Opencart-Playwright-Typescript-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.0.10"
  }
}
