{
    "name": "opencart-playwright-typescript-automation",
    "version": "1.0.0",
    "description": "Uses Playwright &amp; Typescript to automate e2e work flow of Opencart website",
    "main": "index.js",
    "scripts": {
        "build": "npm run build --workspace=packages/pw-core",
        "postinstall": "npm run build --workspace=packages/pw-core",
        "prepare": "husky",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "verify:static": "npm run build && npm run typecheck && npm run lint && npm run format:check",
        "verify:sut": "node scripts/sut-health-check.mjs",
        "verify:api": "playwright test src/tests/api/",
        "verify:smoke": "playwright test --grep @smoke",
        "verify:wishlist": "playwright test --grep @wishlist",
        "verify": "npm run verify:static && npm run verify:sut && npm run verify:api && npm run verify:smoke",
        "verify:full": "npm run verify:static && npm run verify:sut && playwright test",
        "pretest": "npm run build",
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "report": "playwright show-report",
        "test:docker": "docker build -t playwright-tests . && docker run --rm -e CI=true playwright-tests",
        "test:docker:api": "docker build -t playwright-tests . && docker run --rm -e CI=true playwright-tests npx playwright test src/tests/api/",
        "test:docker:hybrid": "docker build -t playwright-tests . && docker run --rm -e CI=true playwright-tests npx playwright test src/tests/hybrid/",
        "test:docker:debug": "docker run -it --rm --entrypoint sh playwright-tests",
        "test:docker:compose": "docker-compose up --build",
        "report:docker": "docker run --rm -v $(pwd)/playwright-report:/app/playwright-report playwright-tests npx playwright show-report"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NandaRam153/Opencart-Playwright-Typescript-automation.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "@opencart-auto/pw-core": "workspace:*"
    },
    "bugs": {
        "url": "https://github.com/NandaRam153/Opencart-Playwright-Typescript-automation/issues"
    },
    "homepage": "https://github.com/NandaRam153/Opencart-Playwright-Typescript-automation#readme",
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@playwright/test": "^1.61.1",
        "@types/node": "^25.0.10",
        "eslint": "^9.21.0",
        "eslint-plugin-playwright": "^2.2.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "playwright": "^1.58.1",
        "prettier": "^3.5.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0"
    },
    "lint-staged": {
        "*.{ts,mjs,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
